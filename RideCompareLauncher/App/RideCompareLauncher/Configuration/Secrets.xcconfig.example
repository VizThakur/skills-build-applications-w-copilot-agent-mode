// Copy this file to "Secrets.xcconfig" in this same directory and fill in
// your own values. Secrets.xcconfig is listed in .gitignore — it must never
// be committed. See the project README's "Configure your Google API key"
// section for how to create and restrict a Google Places API key.

// Required for destination/pickup search to work.
GOOGLE_PLACES_API_KEY = YOUR_GOOGLE_PLACES_API_KEY

// Optional. Your Uber developer app's Client ID, from
// developer.uber.com/dashboard. Uber's ride-request deep link works without
// this — it's only used to attribute the request to your app. Leave blank
// to omit it entirely.
UBER_CLIENT_ID =
