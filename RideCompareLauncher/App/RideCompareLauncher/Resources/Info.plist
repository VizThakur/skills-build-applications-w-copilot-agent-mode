<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!--
	Shown the first time the app requests "when in use" location access, used
	solely to set the rider's current position as the pickup point. See
	LocationService and the README's Privacy section — this value is never
	stored or transmitted anywhere other than into the provider deep links
	the user explicitly taps.
	-->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>RideCompare uses your location to set it as the pickup point when you open Uber, Bolt, or FREE NOW. Your location is never stored or sent anywhere else.</string>

	<!--
	Required so UIApplication.canOpenURL can detect whether Uber / Bolt are
	installed (Apple requires every custom URL scheme an app may query to be
	declared here). FREE NOW is omitted deliberately — see FreeNowProvider.
	-->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>uber</string>
		<string>bolt</string>
	</array>

	<!--
	Populated at build time from Configuration/Secrets.xcconfig — see the
	README's "Configure your Google API key" section. Never commit a real
	key value directly into this file.
	-->
	<key>GooglePlacesAPIKey</key>
	<string>$(GOOGLE_PLACES_API_KEY)</string>
	<key>UberClientID</key>
	<string>$(UBER_CLIENT_ID)</string>
</dict>
</plist>
